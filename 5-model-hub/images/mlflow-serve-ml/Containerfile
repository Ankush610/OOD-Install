# Serves MLflow models (sklearn, XGBoost, LightGBM, CatBoost; skops or cloudpickle format) on CPU: `mlflow models serve --env-manager local`.
# constraints.txt = the lines of the training SIF's `pip freeze` for the packages in pin.txt (4-images.sh makes it):
# every library a pickle depends on (numpy, pandas, scikit-learn, ...) is the exact version the model was trained
# with. Only those: the SIF also pins its Jupyter stack (e.g. cryptography 50), which full mlflow can't use.
FROM docker.io/library/python:3.12-slim
# = the SIF's mlflow-skinny version; pinned so pip fails loudly instead of falling back to an ancient mlflow
ARG MLFLOW_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY constraints.txt verify-pins.py /opt/
# mlflow 3.15.1 declares pandas<3 but the SIF trains with pandas 3.0.5: pandas is left out of the resolve, then forced
# to the SIF's version (a pickled pandas object must load with the pandas that wrote it). Tested end to end, see
# AI-Stack/docs/model-hub/versions/version-1/build-log.md. verify-pins.py fails the build on any other drift.
# pip's cache survives a failed build (a dropped multi-GB download isn't fetched again); 4-images.sh retries
RUN --mount=type=cache,target=/root/.cache/pip \
    grep -v '^pandas==' /opt/constraints.txt > /tmp/c.txt \
 && pip install --retries 10 --timeout 120 -c /tmp/c.txt \
      mlflow==${MLFLOW_VERSION} numpy scipy pandas pyarrow cloudpickle scikit-learn xgboost-cpu lightgbm catboost skops \
 && pip install --no-deps "$(grep '^pandas==' /opt/constraints.txt)" \
 && python /opt/verify-pins.py \
 && python -c "import mlflow, pandas; print('mlflow', mlflow.__version__, 'pandas', pandas.__version__)"
ENV HOME=/tmp MLFLOW_HOME=/tmp PYTHONDONTWRITEBYTECODE=1
USER 65534
ENTRYPOINT ["mlflow", "models", "serve", "--env-manager", "local", "--host", "0.0.0.0", "--port", "8080"]
